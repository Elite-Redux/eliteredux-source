const LOCALID_SCOTT              = 19
const TRAINER_MONOCHAMP_NORMAL   = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_FIGHTING = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_FLYING   = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_POISON   = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_GROUND   = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_ROCK     = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_BUG      = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_GHOST    = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_STEEL    = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_FIRE     = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_WATER    = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_GRASS    = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_ELECTRIC = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_PSYCHIC  = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_ICE      = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_DRAGON   = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_DARK     = TRAINER_MARIA_4
const TRAINER_MONOCHAMP_FAIRY    = TRAINER_MARIA_4

mapscripts EvergrandeCity_MonoChampRoom_1_MapScripts{
    MAP_SCRIPT_ON_FRAME_TABLE
    [
        VAR_TEMP_1, 0: EvergrandeCity_MonoChampRoom_1_OnTrainsition
    ]
}

script EvergrandeCity_MonoChampRoom_1_OnTrainsition{
    lock
    call(EverGrandeCity_MonoChampRoom_1_EventScript_ResetTrainers)
    applymovement(LOCALID_SCOTT, EvergrandeCity_MonoChampRoom_1_MovementScript_Scott_1)
    waitmovement(LOCALID_SCOTT)
    msgbox(format("Welcome to the Type Mono Champion Room, if you defeat all of the trainers here you will be able to get a reward from me, if you want to give up just talk to me and I will take you out of the room, however you will have to defeat all of the trainers again to get the reward, the same goes for if you lose to any of the trainers, Good luck!"))
    applymovement(OBJ_EVENT_ID_PLAYER, EvergrandeCity_MonoChampRoom_1_MovementScript_Player_1)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    applymovement(LOCALID_SCOTT, EvergrandeCity_MonoChampRoom_1_MovementScript_Scott_2)
    waitmovement(LOCALID_SCOTT)
    setvar(VAR_TEMP_1, 1)
    setobjectxyperm(LOCALID_SCOTT, 14, 17)
    release
    end
}

movement  EvergrandeCity_MonoChampRoom_1_MovementScript_Scott_1{
    face_right
}

movement  EvergrandeCity_MonoChampRoom_1_MovementScript_Scott_2{
    walk_right
    face_up
}

movement  EvergrandeCity_MonoChampRoom_1_MovementScript_Player_1{
    walk_up
}

script EverGrandeCity_MonoChampRoom_1_EventScript_ResetTrainers{
    cleartrainerflag(TRAINER_MONOCHAMP_NORMAL)
    cleartrainerflag(TRAINER_MONOCHAMP_FIGHTING)
    cleartrainerflag(TRAINER_MONOCHAMP_FLYING)
    cleartrainerflag(TRAINER_MONOCHAMP_POISON)
    cleartrainerflag(TRAINER_MONOCHAMP_GROUND)
    cleartrainerflag(TRAINER_MONOCHAMP_ROCK)
    cleartrainerflag(TRAINER_MONOCHAMP_BUG)
    cleartrainerflag(TRAINER_MONOCHAMP_GHOST)
    cleartrainerflag(TRAINER_MONOCHAMP_STEEL)
    cleartrainerflag(TRAINER_MONOCHAMP_FIRE)
    cleartrainerflag(TRAINER_MONOCHAMP_WATER)
    cleartrainerflag(TRAINER_MONOCHAMP_GRASS)
    cleartrainerflag(TRAINER_MONOCHAMP_ELECTRIC)
    cleartrainerflag(TRAINER_MONOCHAMP_PSYCHIC)
    cleartrainerflag(TRAINER_MONOCHAMP_ICE)
    cleartrainerflag(TRAINER_MONOCHAMP_DRAGON)
    cleartrainerflag(TRAINER_MONOCHAMP_DARK)
    cleartrainerflag(TRAINER_MONOCHAMP_FAIRY)
    settrainerflag(TRAINER_MONOCHAMP_FAIRY)
    return
}

script EverGrandeCity_MonoChampRoom_1_EventScript_Scott_Outside{
    lock
    faceplayer
    msgbox(format("Do you want to try defeating a bunch of strong trainers to avoid going throught the Victory Road and get a Rare Reward?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == NO){
        msgbox(format("Come back when you are ready"))
    }
    else{
        msgbox(format("Let me take you there"))
        call(EverGrandeCity_MonoChampRoom_1_EventScript_ResetTrainers)
        warp(MAP_EVERGRANDE_CITY_MONO_CHAMP_ROOM_1, 255, 14, 17)
    }
    release
    end
}

script EverGrandeCity_MonoChampRoom_1_EventScript_Scott{
    lock
    faceplayer
    if( defeated(TRAINER_MONOCHAMP_NORMAL)   &&
        defeated(TRAINER_MONOCHAMP_FIGHTING) &&
        defeated(TRAINER_MONOCHAMP_FLYING)   &&
        defeated(TRAINER_MONOCHAMP_POISON)   &&
        defeated(TRAINER_MONOCHAMP_GROUND)   &&
        defeated(TRAINER_MONOCHAMP_ROCK)     &&
        defeated(TRAINER_MONOCHAMP_BUG)      &&
        defeated(TRAINER_MONOCHAMP_GHOST)    &&
        defeated(TRAINER_MONOCHAMP_STEEL)    &&
        defeated(TRAINER_MONOCHAMP_FIRE)     &&
        defeated(TRAINER_MONOCHAMP_WATER)    &&
        defeated(TRAINER_MONOCHAMP_GRASS)    &&
        defeated(TRAINER_MONOCHAMP_ELECTRIC) &&
        defeated(TRAINER_MONOCHAMP_PSYCHIC)  &&
        defeated(TRAINER_MONOCHAMP_ICE)      &&
        defeated(TRAINER_MONOCHAMP_DRAGON)   &&
        defeated(TRAINER_MONOCHAMP_DARK)     &&
        defeated(TRAINER_MONOCHAMP_FAIRY)){
            msgbox(format("Congratulations, you have defeated all of the Type Mono Champions, here is your reward, a Rare Candy"))
            giveitem(ITEM_RARE_CANDY, 1)
            msgbox(format("If you want to try again just talk to me"))
            warp(MAP_VICTORY_ROAD_1F, 255, 46, 15)
    }
    else{
        msgbox(format("Do you want to leave the room?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == NO){
            msgbox(format("Come back when you are ready"))
        }
        else{
            msgbox(format("Let me take you out of the room"))
            call(EverGrandeCity_MonoChampRoom_1_EventScript_ResetTrainers)
            warp(MAP_EVER_GRANDE_CITY, 255, 25, 46)
        }
    }
    release
    end
}

//Normal Type Champion
script EverGrandeCity_MonoChampRoom_1_EventScript_MonoChamp_Normal{
    lock
    faceplayer
    if(defeated(TRAINER_MONOCHAMP_NORMAL) == TRUE){
        msgbox(format("Good luck defeating the other Type Mono Champions"))
    }
    else{
        msgbox(format("Hello, I'm the Normal Type Mono Champion are you ready to fight me?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == NO){
            msgbox(format("Come back when you are ready"))
        }
        else{
            msgbox(format("Let's get started"))
            trainerbattle_no_intro(TRAINER_MONOCHAMP_NORMAL, format("I lost"))
        }
    }
    release
    end
}

