        msgbox(format("Hello, I'm the Grass-type Mono Champion are you ready to fight me?"), MSGBOX_YESNO)
    }

    if(var(VAR_RESULT) == NO){
        msgbox(format("Come back when you are ready"))
    }
    else{
        setvar(VAR_TRAINER_PRIZE_BP, BP_MONOCHAPION_PRIZE)
        setvar(VAR_BATTLE_FIELD_EFFECT_TYPE, BATTLE_FIELD_EFFECT_MONOCHAMP)
        setvar(VAR_BATTLE_FIELD_ID, TYPE_GRASS)
        msgbox(format("Let's get started"))
        trainerbattle_no_intro(TRAINER_MONOCHAMP_GRASS, format("I lost"))
        if(var(VAR_TEMP_2) == TRUE){
            msgbox(format("Whoa... your Grass-type prowess is amazing! Take this with you!"))

            giveitem(ITEM_ABOMASITE_S, 1)
        }
    }
    setvar(VAR_BATTLE_FIELD_EFFECT_TYPE, BATTLE_FIELD_EFFECT_NONE)
    setvar(VAR_BATTLE_FIELD_ID, 0)
    setvar(VAR_MONOTYPE_BOOST, TYPE_NONE)
    release
    end
}

