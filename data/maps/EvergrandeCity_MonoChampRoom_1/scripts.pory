            msgbox(format("Whoa... your Fighting-type prowess is amazing! Take this with you!"))

            givemon(SPECIES_BEWEAR_ANGRY, 80, ITEM_NONE)
            playfanfare(MUS_OBTAIN_ITEM)
            message(format("{PLAYER} got an {COLOR BLUE}Angry Bewear{COLOR DARK_GRAY}!"))
            waitfanfare
        }
    }
    setvar(VAR_BATTLE_FIELD_EFFECT_TYPE, BATTLE_FIELD_EFFECT_NONE)
    setvar(VAR_BATTLE_FIELD_ID, 0)
