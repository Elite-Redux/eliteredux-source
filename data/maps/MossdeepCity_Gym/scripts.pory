script MossdeepCity_Gym_EventScript_CalcDefeatedCount{
	adddefeatedcount(TRAINER_SAMANTHA, 1) // TRAINER_BLAKE
	adddefeatedcount(TRAINER_MAURA) // TRAINER_PRESTON
	adddefeatedcount(TRAINER_SYLVIA) // TRAINER_HANNAH
	adddefeatedcount(TRAINER_KATHLEEN) // TRAINER_NICHOLAS
	adddefeatedcount(TRAINER_MACEY) // TRAINER_CLIFFORD
	adddefeatedcount(TRAINER_NATE) // TRAINER_VIRGIL
	return
}

script MossdeepCity_Gym_EventScript_CheckTrainers{
    if (defeated(TRAINER_TATE_AND_LIZA_1)) {
        msgbox(MossdeepCity_Gym_Text_TateAndLizaPostBattle, MSGBOX_DEFAULT)
        release
        end
    }
	// TRAINER_SAMANTHA => TRAINER_BLAKE
	// TRAINER_MAURA    => TRAINER_PRESTON	
	// TRAINER_SYLVIA   => TRAINER_HANNAH
	// TRAINER_KATHLEEN => TRAINER_NICHOLAS
	// TRAINER_MACEY    => TRAINER_CLIFFORD
	// TRAINER_NATE     => TRAINER_VIRGIL
    call (MossdeepCity_Gym_EventScript_CalcDefeatedCount)
	if (var(VAR_RESULT) < 1 ){
		registerbattleevent(BATTLE_EVENT_LIGHTSCREEN, 5)
	}
	if (var(VAR_RESULT) < 2){
		registerbattleevent(BATTLE_EVENT_REFLECT, 5)
	}
	if (var(VAR_RESULT) < 3){
		registerbattleevent(BATTLE_EVENT_LUCKY_CHANT, 5)
	}
	if (var(VAR_RESULT) < 4){
		registerbattleevent(BATTLE_EVENT_TOXIC_SPIKES)
	}
	if (var(VAR_RESULT) < 5){
	    registerbattleevent(BATTLE_EVENT_LAST_SLEEP, 1)
	}
	if (var(VAR_RESULT) < 6){
		registerbattleevent(BATTLE_EVENT_NO_PROTECT)
	}
}
text MossdeepCity_Gym_Text_TateAndLizaIntro0{
	format("T: We don't need psychic powers to tell us\pL: That you're about to have a bad time.")
}
text MossdeepCity_Gym_Text_TateAndLizaIntro1{
	format("T: You think that with just a few battles you're ready for us?\pL: Very well, but you better make sure you don't complain after you lose!")
}
text MossdeepCity_Gym_Text_TateAndLizaIntroAll{
	format("T: You've strengthened your mind to the fullest\pL: but we hope that you don't think that those tricks were all we had up our sleeves!")
}
script MossdeepCity_Gym_EventScript_TateAndLiza{
    goto_if_set(FLAG_SYS_GAME_CLEAR, MossdeepCity_Gym_EventScript_TateAndLizaRematch)
    call(MossdeepCity_Gym_EventScript_CheckTrainers)
	setvar(VAR_0x8004, 15)
	setvar(VAR_BATTLE_FIELD_EFFECT_TYPE, BATTLE_FIELD_EFFECT_ROOM)
	setvar(VAR_BATTLE_FIELD_ID, STATUS_FIELD_TRICK_ROOM)
	registerbattleevent(BATTLE_EVENT_TENSE_BATTLE)
	call (MossdeepCity_Gym_EventScript_CalcDefeatedCount)
    switch (var(VAR_RESULT)) {
		case 0:
			trainerbattle_double(TRAINER_TATE_AND_LIZA_1, MossdeepCity_Gym_Text_TateAndLizaIntro0, MossdeepCity_Gym_Text_TateAndLizaDefeat, MossdeepCity_Gym_Text_TateAndLizaNeedTwoMons, MossdeepCity_Gym_EventScript_TateAndLizaDefeated, NO_MUSIC)
		break
		case 6:
			trainerbattle_double(TRAINER_TATE_AND_LIZA_1, MossdeepCity_Gym_Text_TateAndLizaIntroAll, MossdeepCity_Gym_Text_TateAndLizaDefeat, MossdeepCity_Gym_Text_TateAndLizaNeedTwoMons, MossdeepCity_Gym_EventScript_TateAndLizaDefeated, NO_MUSIC)
		break
		default:
			trainerbattle_double(TRAINER_TATE_AND_LIZA_1, MossdeepCity_Gym_Text_TateAndLizaIntro1, MossdeepCity_Gym_Text_TateAndLizaDefeat, MossdeepCity_Gym_Text_TateAndLizaNeedTwoMons, MossdeepCity_Gym_EventScript_TateAndLizaDefeated, NO_MUSIC)
		break
	}
	
	clearflag(FLAG_SYS_INVERSE_BATTLE)
	goto_if_eq(MossdeepCity_Gym_EventScript_TateAndLizaRematch)
	goto_if_unset(FLAG_RECEIVED_TM04, MossdeepCity_Gym_EventScript_GiveCalmMind)
	msgbox(MossdeepCity_Gym_Text_TateAndLizaPostBattle, MSGBOX_DEFAULT)
	release
	end

}

script MossdeepCity_Gym_EventScript_AskResetTrainers{
	lock
	clydeaskresettrainers(MossdeepCity_Gym_EventScript_ResetAllTrainers, MossdeepCity_Gym_EventScript_SelectTrainers)
	release
	end
}

script MossdeepCity_Gym_EventScript_ResetAllTrainers{
	cleartrainerflag(TRAINER_SAMANTHA)
	cleartrainerflag(TRAINER_BLAKE)
	cleartrainerflag(TRAINER_MAURA)
	cleartrainerflag(TRAINER_PRESTON)
	cleartrainerflag(TRAINER_SYLVIA)
	cleartrainerflag(TRAINER_HANNAH)
	cleartrainerflag(TRAINER_KATHLEEN)
	cleartrainerflag(TRAINER_NICHOLAS)
	cleartrainerflag(TRAINER_MACEY)
	cleartrainerflag(TRAINER_CLIFFORD)
	cleartrainerflag(TRAINER_NATE)
	cleartrainerflag(TRAINER_VIRGIL)
	cleartrainerflag(TRAINER_TATE_AND_LIZA_1)
	return
}

movement MossdeepCity_Gym_Movement_SylviaAndHannah{
	walk_fastest_left * 5
	walk_fastest_up * 2
}

movement MossdeepCity_Gym_Movement_NateAndVirgil{
	walk_fastest_right * 7
}

movement MossdeepCity_Gym_Movement_MaceyAndClifford{
	walk_fastest_up * 4
}

movement MossdeepCity_Gym_Movement_PrestonAndMaura{
	walk_fastest_left * 7
}
movement MossdeepCity_Gym_Movement_SamantaAndBlake{
	walk_fastest_up * 3
}
movement MossdeepCity_Gym_Movement_KathleenAndNicholas{
	walk_fastest_right * 7
}
movement MossdeepCity_Gym_Movement_TateAndLyza{
	walk_fastest_left * 3
	walk_fastest_up * 3
}

// don't forget to bring you back to the player
movement MossdeepCity_Gym_Movement_Clyde{
	walk_fastest_right * 1
	walk_fastest_down * 12
}

script MossdeepCity_Gym_EventScript_SelectTrainers{
	special(SpawnCameraObject)
	selecttrainercameraoffset()
	selecttrainer(MossdeepCity_Gym_Movement_SylviaAndHannah, "Sylvia & Hannah", TRAINER_SYLVIA, TRAINER_HANNAH)
	selecttrainer(MossdeepCity_Gym_Movement_NateAndVirgil, "Nate & Virgil", TRAINER_NATE, TRAINER_VIRGIL)
	selecttrainer(MossdeepCity_Gym_Movement_MaceyAndClifford, "Macey & Clifford", TRAINER_MACEY, TRAINER_CLIFFORD)
	selecttrainer(MossdeepCity_Gym_Movement_PrestonAndMaura, "Preston & Maura", TRAINER_PRESTON, TRAINER_MAURA)
	selecttrainer(MossdeepCity_Gym_Movement_SamantaAndBlake, "Samanta & Blake", TRAINER_SAMANTHA, TRAINER_BLAKE)
	selecttrainer(MossdeepCity_Gym_Movement_KathleenAndNicholas, "Kathleen & Nicholas", TRAINER_KATHLEEN, TRAINER_NICHOLAS)
	selecttrainer(MossdeepCity_Gym_Movement_TateAndLyza, "Tate & Lyza", TRAINER_TATE_AND_LIZA_1)
	applymovement(OBJ_EVENT_ID_CAMERA, MossdeepCity_Gym_Movement_Clyde)
	waitmovement(0)
	selecttrainercameraoffset(TRUE)
	special(RemoveCameraObject)
	return
}