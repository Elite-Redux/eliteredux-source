	ITEM_SCRAFTITE
	ITEM_FROSLASSITE
	ITEM_RIBOMBITE
	ITEM_URSALUNITE
}

script General_Adoption_Center_Mega_Stones_Script{
	lock
	faceplayer
	checkitem(ITEM_MEGA_BRACELET, 1)
	if(var(VAR_RESULT) == 0){
		msgbox(format("Sorry, I can't sell you any item if you don't have a Mega Braclet"), MSGBOX_DEFAULT)
	}
	else{
		message(gText_HowMayIServeYou)
		setvar(VAR_SHOP_MONEY_TYPE, 1)
		waitmessage
		pokemart(AdoptionCenter_Mega_Stones)
		msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)
		setvar(VAR_SHOP_MONEY_TYPE, 0)
	}
	release
	end
}