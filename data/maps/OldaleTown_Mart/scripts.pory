mart AdoptionCenter_Mega_Stones {
	ITEM_HOUNDOOMINITE_R
	ITEM_SABLENITE_R
	ITEM_GARCHOMPITE_R
	ITEM_ARCANITE_R
	ITEM_SKARMORITE_R
	ITEM_MACHAMPITE_R
	ITEM_BEEDRILLITE_R
	ITEM_TYRANITARITE_R
