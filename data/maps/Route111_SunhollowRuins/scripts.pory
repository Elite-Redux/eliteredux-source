mapscripts Route111_SunhollowRuins_MapScripts {
    
}

const OBJECT_EVENT_MAGMA_GRUNT_1 = 7
const OBJECT_EVENT_MAGMA_GRUNT_2 = 8
const OBJECT_EVENT_MAGMA_GRUNT_3 = 10
const OBJECT_EVENT_MAGMA_GRUNT_4 = 9
const OBJECT_EVENT_MAGMA_GRUNT_5 = 6

script Route111_SunhollowRuins_EventScript_PlayerFound_Talk{
    lock
    faceplayer
    playse(SE_PIN)
	applymovement (VAR_LAST_TALKED, Common_Movement_ExclamationMark)
    goto(Route111_SunhollowRuins_EventScript_PlayerFound_Global)
    end
}

script Route111_SunhollowRuins_EventScript_PlayerFound_Global{
    random (10)
    switch (var(VAR_RESULT)) {
        case 0: msgbox(format("Intruder! Get out of here, we're busy."), MSGBOX_AUTOCLOSE)
        case 1: msgbox(format("You don't need to be here, it's dangerous. Run along, kiddo."), MSGBOX_AUTOCLOSE)
        case 2: msgbox(format("Alright, let's get you back in the tent- Wait, you're an intruder! OUT!"), MSGBOX_AUTOCLOSE)
        case 3: msgbox(format("Team Aqua can't even fund uniforms now? Go on, get gone!"), MSGBOX_AUTOCLOSE)
        case 4: msgbox(format("Look, I can't be bothered fighting you. Just... go away. Don't make me."), MSGBOX_AUTOCLOSE)
        case 5: msgbox(format("AHHH! An intruder! Outoutoutoutout GET OUT OF HERE!"), MSGBOX_AUTOCLOSE)
        case 6: msgbox(format("Can't believe kid trainers are allowed Go-Goggles... Run home, it's unsafe."), MSGBOX_AUTOCLOSE)
        case 7: msgbox(format("RUN, RUN, IT'S- Wait, you're not Norman! Don't scare me like that, brat!"), MSGBOX_AUTOCLOSE)
        case 8: msgbox(format("Must be hallucinating... Get lost, mirage child, I'm watching for intruders."), MSGBOX_AUTOCLOSE)
        case 9: msgbox(format("Right before shift rotation? You messed up your timing."), MSGBOX_AUTOCLOSE)
        case 10: msgbox(format("Have we met somewhere...? Eh, not important. Go on, scoot."), MSGBOX_AUTOCLOSE)
    }
    waitmessage
    warp(MAP_ROUTE111_SUNHOLLOW_RUINS, 0xFF, 51, 40)
    release
    end
}

const OBJECT_EVENT_NORMAN         = 32
const OBJECT_EVENT_SLAKING        = 35
const OBJECT_EVENT_ENTRANCE_GRUNT = 33
const OBJECT_EVENT_EXCADRILL      = 34

script Route111_SunhollowRuins_EventScript_Pre_EntranceScript_1{
    lock
    if(flag(FLAG_HIDE_SUNHOLLOW_ENTRANCE_CHARACTERS)){
        goto(Route111_SunhollowRuins_EventScript_Norman_Entrance)
    }
	applymovement(OBJ_EVENT_ID_PLAYER, moves(
        walk_right * 2
        face_up
        step_end
    ))
    goto(Route111_SunhollowRuins_EventScript_EntranceScript)
}

script Route111_SunhollowRuins_EventScript_Pre_EntranceScript_2{
    lock
    if(flag(FLAG_HIDE_SUNHOLLOW_ENTRANCE_CHARACTERS)){
        goto(Route111_SunhollowRuins_EventScript_Norman_Entrance)
    }
	applymovement(OBJ_EVENT_ID_PLAYER, moves(
        walk_right
        face_up
        step_end
    ))
    goto(Route111_SunhollowRuins_EventScript_EntranceScript)
}

script Route111_SunhollowRuins_EventScript_Pre_EntranceScript_3{
    lock
    if(flag(FLAG_HIDE_SUNHOLLOW_ENTRANCE_CHARACTERS)){
        goto(Route111_SunhollowRuins_EventScript_Norman_Entrance)
    }
    goto(Route111_SunhollowRuins_EventScript_EntranceScript)
}

script Route111_SunhollowRuins_EventScript_Pre_EntranceScript_4{
    lock
    if(flag(FLAG_HIDE_SUNHOLLOW_ENTRANCE_CHARACTERS)){
        goto(Route111_SunhollowRuins_EventScript_Norman_Entrance)
    }
	applymovement(OBJ_EVENT_ID_PLAYER, moves(
        walk_left
        face_up
        step_end
    ))
    goto(Route111_SunhollowRuins_EventScript_EntranceScript)
}

script Route111_SunhollowRuins_EventScript_Pre_EntranceScript_5{
    lock
    if(flag(FLAG_HIDE_SUNHOLLOW_ENTRANCE_CHARACTERS)){
        goto(Route111_SunhollowRuins_EventScript_Norman_Entrance)
    }
	applymovement(OBJ_EVENT_ID_PLAYER, moves(
        walk_left* 2
        face_up
        step_end
    ))
    goto(Route111_SunhollowRuins_EventScript_EntranceScript)
}

script Route111_SunhollowRuins_EventScript_Pre_EntranceScript_6{
    lock
	applymovement(OBJ_EVENT_ID_PLAYER, moves(
        walk_left* 3
        face_up
        step_end
    ))
    goto(Route111_SunhollowRuins_EventScript_EntranceScript)
}

script Route111_SunhollowRuins_EventScript_EntranceScript{
    applymovement(OBJECT_EVENT_SLAKING, moves(walk_right step_end))
    waitmovement(0)
    delay(30)

    playmoncry(SPECIES_ZIGZAGOON, 0)
    delay(60)
    applymovement(OBJECT_EVENT_SLAKING, moves(walk_in_place_fastest_right step_end))
    playse(SE_SUPER_EFFECTIVE)
    waitmovement(0)

    delay(60)
    playmoncry(SPECIES_POOCHYENA, 1)
    delay(60)
    playse(SE_FAINT)
    hideobjectat(OBJECT_EVENT_EXCADRILL, MAP_ROUTE111_SUNHOLLOW_RUINS)
    removeobject(OBJECT_EVENT_EXCADRILL,  MAP_ROUTE111_SUNHOLLOW_RUINS)
	setobjectxyperm(OBJECT_EVENT_EXCADRILL, 1, 1)

    delay(60)
    applymovement(OBJECT_EVENT_SLAKING, moves(walk_left face_right step_end))
    waitmovement(0)

    playse(SE_PIN)
	applymovement(OBJECT_EVENT_ENTRANCE_GRUNT, moves(
        emote_exclamation_mark
        face_down
        step_end
    ))
    waitmovement(0)
    msgbox(format("Another intruder?"))
    closemessage

	applymovement(OBJECT_EVENT_NORMAN, moves(
        emote_question_mark
        face_down
        step_end
    ))
    waitmovement(0)
    delay(60)
    playse(SE_PIN)
	applymovement(OBJECT_EVENT_NORMAN, moves(
        emote_exclamation_mark
        step_end
    ))
    waitmovement(0)
    delay(60)

    msgbox(format("Norman: {PLAYER}, great to see you!"))
    msgbox(format("Take over for me, will you?"))
    closemessage

    playse(SE_BALL_OPEN)
    hideobjectat(OBJECT_EVENT_SLAKING, MAP_ROUTE111_SUNHOLLOW_RUINS)
    removeobject(OBJECT_EVENT_SLAKING,  MAP_ROUTE111_SUNHOLLOW_RUINS)
	setobjectxyperm(OBJECT_EVENT_SLAKING, 1, 1)
    delay(60)

    msgbox(format("Magma Grunt: Wait, hang on-!"))
    closemessage
    delay(10)

	applymovement(OBJ_EVENT_ID_PLAYER, moves(
        walk_up * 3
        face_right
        step_end
    ))
    waitmovement(0)
    applymovement(OBJECT_EVENT_ENTRANCE_GRUNT, moves(face_left step_end))
    waitmovement(0)
    applymovement(OBJECT_EVENT_NORMAN, moves(face_right step_end))
    waitmovement(0)

    msgbox(format("Magma Grunt: So not ONLY do I need to fight a Gym Leader, he tags someone else in halfway through?"))
    closemessage
    msgbox(format("This is ridiculous!"))
    closemessage
    trainerbattle_no_intro(TRAINER_GRUNT_MAGMA_HIDEOUT_1, format("This day keeps getting worse..."))
    goto(Route111_SunhollowRuins_EventScript_EntranceScript_Part_2)
    release
    end
}

script Route111_SunhollowRuins_EventScript_EntranceScript_Part_2{
    msgbox(format("I'm doomed..."))
    closemessage
	applymovement(OBJECT_EVENT_ENTRANCE_GRUNT, moves(
        walk_down * 8
        step_end
    ))
    waitmovement(0)
    hideobjectat(OBJECT_EVENT_ENTRANCE_GRUNT, MAP_ROUTE111_SUNHOLLOW_RUINS)
    removeobject(OBJECT_EVENT_ENTRANCE_GRUNT, MAP_ROUTE111_SUNHOLLOW_RUINS)
	setobjectxyperm(OBJECT_EVENT_ENTRANCE_GRUNT, 1, 1)
	applymovement(OBJECT_EVENT_NORMAN, moves(face_right step_end))
    waitmovement(0)
	applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left step_end))
    waitmovement(0)
    msgbox(format("Norman: I'm a little surprised to see you here, {PLAYER}. I expected Flannery."))
    closemessage
    msgbox(format("Oh, she sent you instead? Hm. I'll need to have a talk with her later..."))
    closemessage
    msgbox(format("But there's no time for that now!"))
    closemessage

	applymovement(OBJECT_EVENT_NORMAN, moves(
        face_up
        step_end
    ))
    waitmovement(0)
    msgbox(format("Norman: Team Magma is infiltrating the pyramid"))
    closemessage
    msgbox(format("I've got an old friend coming, but it's too risky for you to fight through."))
    closemessage

	applymovement(OBJECT_EVENT_NORMAN, moves(
        face_right
        step_end
    ))
    waitmovement(0)
    msgbox(format("But they seem to be less dense out to the east. Maybe you can sneak through?"))
    closemessage
    msgbox(format("Don't let them catch you! They know I'm here, but they won't expect you."))
    closemessage

    setflag(FLAG_HIDE_SUNHOLLOW_ENTRANCE_CHARACTERS)
    msgbox(format("Do you feel up to it?"), MSGBOX_YESNO)
    goto(Route111_SunhollowRuins_EventScript_Norman_Question)
    release
    end
}

script Route111_SunhollowRuins_EventScript_Norman_Question {
    if(var(VAR_RESULT) == YES){
        msgbox(format("Norman: That's my boy. Good luck!"))
        closemessage
	    fadescreen(FADE_TO_BLACK)
        hideobjectat(OBJECT_EVENT_NORMAN, MAP_ROUTE111_SUNHOLLOW_RUINS)
        removeobject(OBJECT_EVENT_NORMAN, MAP_ROUTE111_SUNHOLLOW_RUINS)
        setobjectxyperm(OBJECT_EVENT_NORMAN, 1, 1)
        setflag(FLAG_HIDE_SUNHOLLOW_NORMAN)
        setvar(VAR_SUNHOLLOW_STATE, 1)
        playse(SE_EXIT)
        delay(10)
	    fadescreen(FADE_FROM_BLACK)
    }
    else{
        msgbox(format("Norman: I understand. Go take some time to prepare, but please hurry!"))
        closemessage
        warp(MAP_ROUTE111_SUNHOLLOW_RUINS, 0xFF, 51, 46)
    }
    release
    end
}

script Route111_SunhollowRuins_EventScript_Norman_Entrance {
    playse(SE_PIN)
	applymovement(OBJECT_EVENT_NORMAN, moves(
        emote_exclamation_mark
        face_down
        step_end
    ))
    waitmovement(0)
    msgbox(format("You're back! Are you ready?"), MSGBOX_YESNO)
    goto(Route111_SunhollowRuins_EventScript_Norman_Question)
}
