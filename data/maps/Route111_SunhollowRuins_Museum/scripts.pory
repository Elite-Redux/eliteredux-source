    goto(Route111_SunhollowRuins_Museum_EventScript_PyramidScript_Global)
}
script Route111_SunhollowRuins_Museum_EventScript_PyramidScript_MovePlayerToScriptStart {
    switch(var(VAR_TEMP_0)){
        case 2:
            applymovement(OBJECT_EVENT_NORMAN,  moves(walk_fastest_up step_end))
            applymovement(OBJECT_EVENT_BRANDON, moves(walk_fastest_up step_end))
            waitmovement(0)
        break
        case 3:
            applymovement(OBJECT_EVENT_NORMAN,  moves(walk_fastest_up * 2 step_end))
            applymovement(OBJECT_EVENT_BRANDON, moves(walk_fastest_up * 2 step_end))
            waitmovement(0)
        break
        case 4:
            applymovement(OBJECT_EVENT_NORMAN,  moves(walk_fastest_up * 3 step_end))
            applymovement(OBJECT_EVENT_BRANDON, moves(walk_fastest_up * 3 step_end))
            waitmovement(0)
        break
        case 5:
            applymovement(OBJECT_EVENT_NORMAN,  moves(walk_fastest_up * 4 step_end))
            applymovement(OBJECT_EVENT_BRANDON, moves(walk_fastest_up * 4 step_end))
            waitmovement(0)
        break
        case 6:
            applymovement(OBJECT_EVENT_NORMAN,  moves(walk_fastest_up * 5 step_end))
            applymovement(OBJECT_EVENT_BRANDON, moves(walk_fastest_up * 5 step_end))
            waitmovement(0)
        break
        case 7:
            applymovement(OBJECT_EVENT_NORMAN,  moves(walk_fastest_up * 6 step_end))
            applymovement(OBJECT_EVENT_BRANDON, moves(walk_fastest_up * 6 step_end))
            waitmovement(0)
        break
        case 8:
            applymovement(OBJECT_EVENT_NORMAN,  moves(walk_fastest_up * 7 step_end))
            applymovement(OBJECT_EVENT_BRANDON, moves(walk_fastest_up * 7 step_end))
            waitmovement(0)
        break
    }
    
    applymovement(OBJECT_EVENT_NORMAN, moves(
        walk_up * 6
        walk_right * 2
        step_end
    ))
    applymovement(OBJECT_EVENT_BRANDON, moves(
        walk_up * 7
        walk_right
        step_end
    ))
    waitmovement(0)

    msgbox(format("Norman: Fall back, {PLAYER}, we need to talk strategy."))
    closemessage

    applymovement(OBJECT_EVENT_BRANDON, moves(
        walk_left
        walk_down * 2
        step_end
    ))
    applymovement(OBJECT_EVENT_NORMAN, moves(
        walk_left * 2
        walk_down
        step_end
    ))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(
        walk_left * 2
        walk_down
        step_end
    ))
    waitmovement(0)

    //Move player next to Norman
    switch(var(VAR_TEMP_0)){
        case 1:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_down * 4
                face_left
                step_end
            ))
            applymovement(OBJECT_EVENT_NORMAN, moves(
                walk_down * 4
                face_right
                step_end
            ))
            applymovement(OBJECT_EVENT_BRANDON, moves(
                walk_down * 4
                face_right
                step_end
            ))
        break
        case 2:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_down * 5
                face_left
                step_end
            ))
            applymovement(OBJECT_EVENT_NORMAN, moves(
                walk_down * 5
                face_right
                step_end
            ))
            applymovement(OBJECT_EVENT_BRANDON, moves(
                walk_down * 5
                face_right
                step_end
            ))
        break
        case 3:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_down * 6
                face_left
                step_end
            ))
            applymovement(OBJECT_EVENT_NORMAN, moves(
                walk_down * 6
                face_right
                step_end
            ))
            applymovement(OBJECT_EVENT_BRANDON, moves(
                walk_down * 6
                face_right
                step_end
            ))
        break
        case 4:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_down * 7
                face_left
                step_end
            ))
            applymovement(OBJECT_EVENT_NORMAN, moves(
                walk_down * 7
                face_right
                step_end
            ))
            applymovement(OBJECT_EVENT_BRANDON, moves(
                walk_down * 7
                face_right
                step_end
            ))
        break
        case 5:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_down * 8
                face_left
                step_end
            ))
            applymovement(OBJECT_EVENT_NORMAN, moves(
                walk_down * 8
                face_right
                step_end
            ))
            applymovement(OBJECT_EVENT_BRANDON, moves(
                walk_down * 8
                face_right
                step_end
            ))
        break
        case 6:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_down * 9
                face_left
                step_end
            ))
            applymovement(OBJECT_EVENT_NORMAN, moves(
                walk_down * 9
                face_right
                step_end
            ))
            applymovement(OBJECT_EVENT_BRANDON, moves(
                walk_down * 9
                face_right
                step_end
            ))
        break
        case 7:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_down * 10
                face_left
                step_end
            ))
            applymovement(OBJECT_EVENT_NORMAN, moves(
                walk_down * 10
                face_right
                step_end
            ))
            applymovement(OBJECT_EVENT_BRANDON, moves(
                walk_down * 10
                face_right
                step_end
            ))
        break
        case 8:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_down * 11
                face_left
                step_end
            ))
            applymovement(OBJECT_EVENT_NORMAN, moves(
                walk_down * 11
                face_right
                step_end
            ))
            applymovement(OBJECT_EVENT_BRANDON, moves(
                walk_down * 11
                face_right
                step_end
            ))
        break
    }
    waitmovement(0)

    return
}

script Route111_SunhollowRuins_Museum_EventScript_PyramidScript_Global {
    msgbox(format("Norman: Psst! {PLAYER}! Wait!"))
    closemessage
    clearflag(FLAG_TEMP_2)

	addobject(OBJECT_EVENT_NORMAN)
	addobject(OBJECT_EVENT_BRANDON)
    playse(SE_PIN)
	applymovement(OBJ_EVENT_ID_PLAYER, moves(
        emote_exclamation_mark
        face_left
        step_end
    ))
    waitmovement(0)

    call(Route111_SunhollowRuins_Museum_EventScript_PyramidScript_MovePlayerToScriptStart)

    msgbox(format("Norman: {PLAYER}, this is Brandon."))
    closemessage

    applymovement(OBJECT_EVENT_NORMAN, moves(
        face_down
        step_end
    ))
    waitmovement(0)

    msgbox(format("Norman: Brandon, meet my son {PLAYER}\p"
                  "Brandon: Well met, young adventurer!\p"
                  "Brandon, how's your team?"))
    closemessage

    applymovement(OBJECT_EVENT_BRANDON, moves(
        face_up
        step_end
    ))
    waitmovement(0)

    msgbox(format("Brandon: Exhausted. Yours?\p"
                  "Norman: Also quite tired."))
    closemessage

    applymovement(OBJECT_EVENT_NORMAN, moves(
        face_right
        step_end
    ))
    waitmovement(0)

    msgbox(format("Norman: {PLAYER}, you snuck in, you're still fresh, right?\p"
                  "But that's a lot of Magma members...\p"
                  "What's our plan?"))
    closemessage

    playse(SE_BANG)
    delay(30)

    playse(SE_PIN)
	applymovement(OBJECT_EVENT_BRANDON, moves(
        emote_question_mark
        face_down
        step_end
    ))
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(
        face_down
        step_end
    ))
    waitmovement(0)
    applymovement(OBJECT_EVENT_NORMAN, moves(
        face_down
        step_end
    ))
    waitmovement(0)

    msgbox(format("Brandon: Do you two hear that?\p"
                  "Norman: Hear what?\p"
                  "???: OUTTA THE WAY, COMIN' THROUGH!"))
    closemessage

    applymovement(OBJ_EVENT_ID_PLAYER, moves(
        walk_up
        walk_left
        face_right
        step_end
    ))
    waitmovement(0)
    applymovement(OBJECT_EVENT_NORMAN, moves(
        face_right
        step_end
    ))
    applymovement(OBJECT_EVENT_BRANDON, moves(
        face_right
        step_end
    ))
    waitmovement(0)
    clearflag(FLAG_TEMP_1)
	addobject(OBJECT_EVENT_AQUA_MEMBER_1)
	addobject(OBJECT_EVENT_AQUA_MEMBER_2)
	addobject(OBJECT_EVENT_AQUA_MEMBER_3)
	addobject(OBJECT_EVENT_AQUA_MEMBER_4)
	addobject(OBJECT_EVENT_AQUA_MEMBER_5)
	addobject(OBJECT_EVENT_AQUA_MEMBER_6)
	addobject(OBJECT_EVENT_AQUA_MEMBER_7)
	addobject(OBJECT_EVENT_AQUA_MEMBER_8)

    applymovement(OBJECT_EVENT_AQUA_MEMBER_1, moves(
        walk_fast_up * 20
        step_end
    ))
    applymovement(OBJECT_EVENT_AQUA_MEMBER_2, moves(
        walk_fast_up * 20
        step_end
    ))
    applymovement(OBJECT_EVENT_AQUA_MEMBER_3, moves(
        walk_fast_up * 20
        step_end
    ))
    applymovement(OBJECT_EVENT_AQUA_MEMBER_4, moves(
        walk_fast_up * 20
        step_end
    ))
    applymovement(OBJECT_EVENT_AQUA_MEMBER_5, moves(
        walk_fast_up * 20
        step_end
    ))
    applymovement(OBJECT_EVENT_AQUA_MEMBER_6, moves(
        walk_fast_up * 20
        step_end
    ))
    applymovement(OBJECT_EVENT_AQUA_MEMBER_7, moves(
        walk_fast_up * 20
        step_end
    ))
    applymovement(OBJECT_EVENT_AQUA_MEMBER_8, moves(
        walk_fast_up * 20
        step_end
    ))
    waitmovement(0)
    
    applymovement(OBJECT_EVENT_NORMAN, moves(
        face_up
        step_end
    ))
    applymovement(OBJECT_EVENT_BRANDON, moves(
        face_up
        step_end
    ))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(
        face_up
        step_end
    ))
    waitmovement(0)

    msgbox(format("Brandon: ...Well. That answers that!\p"
                  "Norman: This is our chance! We'll support them, you go on ahead!"))
    closemessage
    applymovement(OBJECT_EVENT_BRANDON, moves(
        walk_fast_right
        walk_fast_up * 1
        step_end
    ))
    waitmovement(0)
    applymovement(OBJECT_EVENT_BRANDON, moves(
        walk_fast_up * 9
        step_end
    ))
    applymovement(OBJECT_EVENT_NORMAN, moves(
        walk_fast_right
        walk_fast_up * 5
        face_down
        step_end
    ))
    waitmovement(0)
    msgbox(format("Norman: Be careful, OK, {PLAYER}?"))
    closemessage

    applymovement(OBJECT_EVENT_NORMAN, moves(
        walk_fast_up * 10
        step_end
    ))
    waitmovement(0)
    
    hideobjectat(OBJECT_EVENT_NORMAN, MAP_ROUTE111_SUNHOLLOW_RUINS)
    removeobject(OBJECT_EVENT_NORMAN,  MAP_ROUTE111_SUNHOLLOW_RUINS)
	setobjectxyperm(OBJECT_EVENT_NORMAN, 1, 1)
    
    hideobjectat(OBJECT_EVENT_BRANDON, MAP_ROUTE111_SUNHOLLOW_RUINS)
    removeobject(OBJECT_EVENT_BRANDON,  MAP_ROUTE111_SUNHOLLOW_RUINS)
	setobjectxyperm(OBJECT_EVENT_BRANDON, 1, 1)

    setflag(FLAG_TEMP_1)
    setflag(FLAG_TEMP_2)

    setvar(VAR_SUNHOLLOW_STATE, 2)
    release
    end
}
