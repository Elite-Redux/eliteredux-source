const OBJECT_EVENT_BRANDON        = 6

const OBJECT_EVENT_NORMAN_2       = 21
const OBJECT_EVENT_BRANDON_2      = 22

const OBJECT_EVENT_AQUA_MEMBER_1  = 19
const OBJECT_EVENT_AQUA_MEMBER_2  = 18
const OBJECT_EVENT_AQUA_MEMBER_3  = 15
const OBJECT_EVENT_AQUA_MEMBER_4  = 16
const OBJECT_EVENT_AQUA_MEMBER_5  = 17

const OBJECT_EVENT_MAGMA_MEMBER_1 = 14
const OBJECT_EVENT_MAGMA_MEMBER_2 = 3

const OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_1 = 31
const OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_2 = 26
const OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_3 = 28
const OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_4 = 23
const OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_5 = 24
const OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_6 = 34
const OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_7 = 29
const OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_8 = 20

const OBJECT_EVENT_FIGHTING_MEMBER_AQUA_1  = 30
const OBJECT_EVENT_FIGHTING_MEMBER_AQUA_2  = 27
const OBJECT_EVENT_FIGHTING_MEMBER_AQUA_3  = 25
const OBJECT_EVENT_FIGHTING_MEMBER_AQUA_4  = 32
const OBJECT_EVENT_FIGHTING_MEMBER_AQUA_5  = 33

mapscripts Route111_SunhollowRuins_Museum_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        switch(var(VAR_SUNHOLLOW_STATE)){
            default: //First time
                setflag(FLAG_TEMP_1)
                setflag(FLAG_TEMP_2)
                setflag(FLAG_TEMP_3)
                setflag(FLAG_TEMP_5)
                setvar(VAR_SUNHOLLOW_STATE, 1)
            break
            case 2: //Mid conflict
                setflag(FLAG_TEMP_1)
                setflag(FLAG_TEMP_2)
                setflag(FLAG_TEMP_5)
            break
            case 3: //Everything Finished
                playbgm(MUS_B_PYRAMID, 0)
                setflag(FLAG_TEMP_1)
                setflag(FLAG_TEMP_2)
                setflag(FLAG_TEMP_3)
                setflag(FLAG_TEMP_4)
                setflag(FLAG_TEMP_5)
                setflag(FLAG_TEMP_6)
                setflag(FLAG_HIDE_SUNHOLLOW_MUSEUM_MAGMA_GRUNTS)
            break
        }
    }
}

