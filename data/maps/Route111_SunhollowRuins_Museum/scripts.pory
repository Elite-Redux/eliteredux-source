    release
    end
}

script Route111_SunhollowRuins_Museum_EventScript_Brandon_Fighting {
    lock
    msgbox(format("Hah! Ruins are my homeground! En guarde!"))
    closemessage
    release
    end
}

script Route111_SunhollowRuins_Museum_EventScript_Magma_Grunt_1 {
	trainerbattle_single(TRAINER_GRUNT_MAGMA_HIDEOUT_14, format("How did you get in here?! Those guards must be sleeping...\pFine, I'll take care of you myself!"), format("No! No, you can't, we need to- Oops, nearly gave it away!"))
	msgbox(format("I don't suppose I could convince you to turn around and head home, could I?"), MSGBOX_AUTOCLOSE)
	end
}

script Route111_SunhollowRuins_Museum_EventScript_Magma_Grunt_2 {
	trainerbattle_single(TRAINER_GRUNT_MAGMA_HIDEOUT_2, format("Hey, this is a historical site, you oughta be careful!"), format("Wait, you think WE'RE the vandals?!"))
	msgbox(format("What? We're being careful too. It's not any more ruined than when we arrived."), MSGBOX_AUTOCLOSE)
	end
}

const OBJECT_EVENT_MAXIE    = 2
const OBJECT_EVENT_COURTNEY = 1

script Route111_SunhollowRuins_Museum_EventScript_Courtney_Script_1 {
    lock
    setvar(VAR_TEMP_1, 0)
    goto(Route111_SunhollowRuins_Museum_EventScript_Courtney_Global_Script)
    end
}

script Route111_SunhollowRuins_Museum_EventScript_Courtney_Script_2 {
    lock
    setvar(VAR_TEMP_1, 1)
    goto(Route111_SunhollowRuins_Museum_EventScript_Courtney_Global_Script)
    end
}

script Route111_SunhollowRuins_Museum_EventScript_Courtney_Global_Script {
    switch(var(VAR_TEMP_1)){
        case 0:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_up   * 4
                walk_left * 2
                step_end
            ))
        break
        case 1:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_up   * 4
                walk_left * 3
                step_end
            ))
        break
    }
    waitmovement(0)

    msgbox(format("Maxie: ...and if that's the Scorched Slab, then...\pthen they're at Mt Pyre?"))
    closemessage

    playse(SE_PIN)
	applymovement(OBJECT_EVENT_COURTNEY, moves(
        emote_exclamation_mark
        face_down
        step_end
    ))
    waitmovement(0)
	playbgm(MUS_ENCOUNTER_MAGMA, 0)
    delay(60)

    msgbox(format("Courtney: Maxie, caution! The meddling child from Mt Chimney is here."))

    playse(SE_PIN)
	applymovement(OBJECT_EVENT_MAXIE, moves(
        emote_exclamation_mark
        face_down
        step_end
    ))
    waitmovement(0)

    msgbox(format("Maxie: NOW?!\pArgh, I need more time!"))
    closemessage
	applymovement(OBJECT_EVENT_MAXIE, moves(
        face_left
        step_end
    ))
    waitmovement(0)
    msgbox(format("Courtney, keep him busy!"))
    closemessage
	applymovement(OBJECT_EVENT_COURTNEY, moves(
        face_right
        step_end
    ))
    waitmovement(0)
    msgbox(format("Courtney: Yes! Engaging."))
    closemessage

	applymovement(OBJECT_EVENT_COURTNEY, moves(
        walk_down  * 2
        walk_right * 2
        step_end
    ))
    waitmovement(0)
    trainerbattle_no_intro(TRAINER_COURTNEY_SUNHOLLOW, format("I do hope I bought Maxie enough time."))
    release
    end
}
