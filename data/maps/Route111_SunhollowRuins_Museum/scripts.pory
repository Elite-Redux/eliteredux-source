const OBJECT_EVENT_AQUA_MEMBER_2  = 21
const OBJECT_EVENT_AQUA_MEMBER_3  = 15
const OBJECT_EVENT_AQUA_MEMBER_4  = 16
const OBJECT_EVENT_AQUA_MEMBER_5  = 17
const OBJECT_EVENT_AQUA_MEMBER_6  = 18
const OBJECT_EVENT_AQUA_MEMBER_7  = 19
const OBJECT_EVENT_AQUA_MEMBER_8  = 20

const OBJECT_EVENT_MAGMA_MEMBER_1 = 14
const OBJECT_EVENT_MAGMA_MEMBER_2 = 3

const OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_1 = 34
const OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_2 = 29
const OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_3 = 31
const OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_4 = 26
const OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_5 = 27
const OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_6 = 37
const OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_7 = 32
const OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_8 = 23

const OBJECT_EVENT_FIGHTING_MEMBER_AQUA_1  = 33
const OBJECT_EVENT_FIGHTING_MEMBER_AQUA_2  = 30
const OBJECT_EVENT_FIGHTING_MEMBER_AQUA_3  = 28
const OBJECT_EVENT_FIGHTING_MEMBER_AQUA_4  = 35
const OBJECT_EVENT_FIGHTING_MEMBER_AQUA_5  = 36

mapscripts Route111_SunhollowRuins_Museum_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        switch(var(VAR_SUNHOLLOW_STATE)){
            default: //First time
                setflag(FLAG_TEMP_1)
                setflag(FLAG_TEMP_2)
                setflag(FLAG_TEMP_3)
                setvar(VAR_SUNHOLLOW_STATE, 1)
            break
            case 2: //Mid conflict
                setflag(FLAG_TEMP_1)
                setflag(FLAG_TEMP_2)
            break
            case 3: //Everything Finished
	            playbgm(MUS_B_PYRAMID, 0)
                setflag(FLAG_TEMP_1)
                setflag(FLAG_TEMP_2)
                setflag(FLAG_TEMP_3)
                setflag(FLAG_TEMP_4)
                setflag(FLAG_HIDE_SUNHOLLOW_MUSEUM_MAGMA_GRUNTS)
            break
        }
    }
}

