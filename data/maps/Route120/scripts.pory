	end

Route120_Text_StevenGreeting: @ 81F5998
	.string "Steven: Hm? {PLAYER}{KUN}, hi.\n"
	.string "It's been a while.\p"
	.string "There's something here that you can't\n"
	.string "see, right?\p"
	.string "Now, if I were to use this device on\n"
	.string "the invisible obstacle…\p"
	.string "No, no. Rather than describing it,\n"
	.string "I should just show you.\l"
	.string "That would be more fun.\p"
	.string "{PLAYER}{KUN}, are your Pokémon ready for\n"
	.string "battle?$"

Route120_Text_StevenIllWaitHere: @ 81F5AAC
	.string "Steven: No?\p"
	.string "I'll wait here, so you can get ready.$"

Route120_Text_StevenReadyForBattle: @ 81F5ADE
	.string "Steven: {PLAYER}{KUN}, are your Pokémon\n"
	.string "ready for battle?$"

Route120_Text_StevenShowMeYourPower: @ 81F5B0F
	.string "Steven: {PLAYER}{KUN}, show me your true\n"
	.string "power as a Trainer!$"

Route120_Text_StevenUsedDevonScope: @ 81F5B43
	.string "Steven used the Devon Scope.\p"
	.string "An invisible Pokémon became completely\n"
	.string "visible!\p"
	.string "The startled Pokémon attacked!$"

Route120_Text_StevenGiveDevonScope: @ 81F5BAF
	.string "Steven: I see…\n"
	.string "Your battle style is intriguing.\p"
	.string "Your Pokémon have obviously grown\n"
	.string "since I first met you in Dewford.\p"
	.string "I'd like you to have this\n"
	.string "Devon Scope.\p"
	.string "Who knows, there may be other\n"
	.string "concealed Pokémon.$"

Route120_Text_StevenGoodbye: @ 81F5C7B
	.string "Steven: {PLAYER}{KUN}.\p"
	.string "I enjoy seeing Pokémon and Trainers\n"
	.string "who strive together.\p"
	.string "I think you're doing great.\p"
	.string "Well, let's meet again somewhere.$"

Kecleon_Text_SomethingUnseeable: @ 81F5D00
	.string "Something unseeable is in the way.$"

Kecleon_Text_WantToUseDevonScope: @ 81F5D23
	.string "Something unseeable is in the way.\p"
	.string "Want to use the Devon Scope?$"

Kecleon_Text_UseDevonScopeMonAttacked: @ 81F5D63
	.string "{PLAYER} used the Devon Scope.\p"
	.string "An invisible Pokémon became completely\n"
	.string "visible!\p"
	.string "The startled Pokémon attacked!$"

Route120_Text_RouteSignFortree: @ 81F5DCB
	.string "Route 120\n"
	.string "{LEFT_ARROW} Fortree City$"

Route120_Text_RouteSign121: @ 81F5DE4
	.string "{RIGHT_ARROW} Route 121\n"
	.string "{LEFT_ARROW} Route 120$"
`
script Route120_EventScript_LegendaryNPC{
    lock
    faceplayer
	msgbox(format("Sage: I know a lot about this place, more than you could imagine. Wanna hear me talk about it?"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == 1){
		if (!flag(FLAG_SYS_GAME_CLEAR)){
		msgbox(format("It might not seem like it at first, but you have entered the domain of the Forces of Nature.\p"
		"They strayed all the way from Unova to here, looking for wild lands to unleash their powers onto.\p"
		"But, despite what we initially feared, it seems like Hoenn has rather soothed their spirits.\p"
		"No ferocious gales nor fierce thunderstorms have grazed this place, yet.\p"
		"Perhaps their master, Landorus, has regained control of them? Nobody knows for sure.\p"
		"If you want to catch them, however, you must first prove your worth by becoming champion!"))
	}
	else{
		if(defeated(TRAINER_COLIN)  &&
		   defeated(TRAINER_ROBERT_1)  &&
		   defeated(TRAINER_LORENZO)  &&
		   defeated(TRAINER_JENNA)  &&
		   defeated(TRAINER_JEFFREY_1)  &&
		   defeated(TRAINER_JENNIFER)  &&
		   defeated(TRAINER_CHIP)  &&
		   defeated(TRAINER_CLARISSA)  &&
		   defeated(TRAINER_ANGELICA)  &&
		   defeated(TRAINER_KEIGO)  &&
		   defeated(TRAINER_RILEY)  &&
		   defeated(TRAINER_LEONEL)  &&
		   defeated(TRAINER_CALLIE)){
			msgbox(format("Seek after the eye of the storm: the Forces of Nature have deemed you worthy of meeting them. Use your DexNav to discover their location, and get ready to face nature's wrath!"))
		}
		else{
			msgbox(format("I can sense it: the Forces of Nature are awake and vigilant. They're almost ready to come out and meet you. Defeat the remaining trainers on this route to meet them!"))
		}
	}
	}
	else{
		msgbox(format("Oh..."))}
    release
    end
}
const MAWOOTAD_NPC = 37

script Route120_EventScript_MawootadNPC{
    lockall
    faceplayer
    msgbox(format("Hey You're the kid who saved my research from being stolen!\p"
    "It's perfect, follow me I need to show you something!"))
    closemessage
    switch(var(VAR_FACING)){
        case DIR_WEST:
           applymovement(OBJ_EVENT_ID_PLAYER, Route120_Movement_MawootadNPCCorrectWest)
           waitmovement(0)
        break
        case DIR_NORTH :
            applymovement(OBJ_EVENT_ID_PLAYER, Route120_Movement_MawootadNPCCorrectNorth)
            waitmovement(0)
        break
        case DIR_SOUTH :
            applymovement(OBJ_EVENT_ID_PLAYER, Route120_Movement_MawootadNPCCorrectSouth)
            waitmovement(0)
        break
    }
    applymovement(MAWOOTAD_NPC, Route120_Movement_MawootadNPCWalk1)
    applymovement(OBJ_EVENT_ID_PLAYER, Route120_Movement_MawootadNPCWalk1)
    waitmovement(0)
    call(Route120_EventScript_MawootadNPCQuestion1)
    releaseall
    end
}
movement Route120_Movement_MawootadNPCCorrectNorth{
    walk_left
    walk_up
    face_right
}
movement Route120_Movement_MawootadNPCCorrectWest{
    walk_down
    walk_left * 2
    walk_up
    face_right
}
movement Route120_Movement_MawootadNPCCorrectSouth{
    walk_left
    walk_down
    face_right
}
movement Route120_Movement_MawootadNPCWalk1{
    walk_right * 6
}
script Route120_EventScript_MawootadNPCQuestion1{
    msgbox(format("Oh i may ask you question before showing you my latest research.\p"
    "If you don't have the basics i'll just bore you."), MSGBOX_YESNO)
    if (var(VAR_RESULT) != 1){
        msgbox(format("Alright, see you next time then"))
        closemessage
        applymovement(MAWOOTAD_NPC, Route120_EventScript_MawootadNPCWalkAway)
        setflag(FLAG_HIDE_MAWOOTAD)
        waitmovement(0)
        return
    }
    call(Route120_EventScript_MawootadNPCAskQuestion)
    setflag(FLAG_HIDE_MAWOOTAD)
    return
}

script Route120_EventScript_MawootadNPCAskQuestion{
    // count the number of skipped trainer in weather institute
    setvar(VAR_TEMP_2, 0)
    if (!defeated(TRAINER_GRUNT_WEATHER_INST_1)){ //avoidable if not 4
        addvar(VAR_TEMP_2, 1)
    }
    if (!defeated(TRAINER_GRUNT_WEATHER_INST_3)){ //avoidable
        addvar(VAR_TEMP_2, 1)
    }
    if (!defeated(TRAINER_GRUNT_WEATHER_INST_4)){ //avoidable if not 1
        addvar(VAR_TEMP_2, 1)
    }
    // the more trainers have been skipped, the harder the question will be
    faceplayer
    if (var(VAR_TEMP_2) >= 2){ // Totally unfair question
        msgbox(format("Alright, how many letters i and o have i have been saying since now?"))
        multichoice2(0, 0, MultiChoice_MawootadTotallyUnfairQuestion)
        switch(var(VAR_RESULT)){
            case 12:
                msgbox(format("Easy enough, you follow. Lets get ahead!"))
                closemessage
                call(Route120_EventScript_MawootadNPCRightAnswer)
            break
            default:
                call(Route120_EventScript_MawootadNPCWrongAnswer)
        
        }
    } elif (var(VAR_TEMP_2) == 1){ // Finland
        msgbox(format("What is a Metang?"))
        multichoice2(0, 0, MultiChoice_MawootadFinlandQuestion)
        switch(var(VAR_RESULT)){
            case 1:
                msgbox(format("From a genetic biologist point of view, any pokemon can be at 99% a Scorbuny"))
                closemessage
                call(Route120_EventScript_MawootadNPCRightAnswer)
            break
            default:
                call(Route120_EventScript_MawootadNPCWrongAnswer)
        
        }
    } else { // XD
        msgbox(format("Who is the nicest girl gym leader?"))
        multichoice2(0, 0, MultiChoice_MawootadXDQuestion)
        switch(var(VAR_RESULT)){
            case 2:
                call(Route120_EventScript_MawootadNPCWrongAnswer)
            break
            default:
                msgbox(format("As long it is not Flannery."))
                closemessage
                call(Route120_EventScript_MawootadNPCRightAnswer)
        
        }
    }
}
script Route120_EventScript_MawootadNPCWrongAnswer{
    msgbox(format("WROOONG! How can someone be wrong on that. That's it i leave!"))
    closemessage
    applymovement(MAWOOTAD_NPC, Route120_EventScript_MawootadNPCWalkAway)
    waitmovement(0)
    setflag(FLAG_HIDE_MAWOOTAD)
	removeobject(MAWOOTAD_NPC)
    return
}
script Route120_EventScript_MawootadNPCRightAnswer{
    applymovement(MAWOOTAD_NPC, Route120_EventScript_MawootadNPCWalkAway)
    applymovement(OBJ_EVENT_ID_PLAYER, Route120_EventScript_MawootadNPCTrainerFollowUp)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Route120_EventScript_MawootadNPCTrainerCatchUp)
    waitmovement(0)
    playse(SE_PIN)
	applymovement(MAWOOTAD_NPC, Common_Movement_ExclamationMark)
	applymovement(MAWOOTAD_NPC, Common_Movement_WalkInPlaceFastestRight)
	waitmovement(0)
	msgbox(format("..."))
	setvar(VAR_0x8004, 1)  //vertical pan
	setvar(VAR_0x8005, 1)  //horizontal pan
	setvar(VAR_0x8006, 2)  //num shakes
	setvar(VAR_0x8007, 7)  //shake delay
	special(ShakeCamera)
	waitstate
	applymovement(MAWOOTAD_NPC, Common_Movement_WalkInPlaceFastestRight)
	waitmovement(0)
	msgbox(format("Someone..."))
	setvar(VAR_0x8004, 1)  //vertical pan
	setvar(VAR_0x8005, 1)  //horizontal pan
	setvar(VAR_0x8006, 4)  //num shakes
	setvar(VAR_0x8007, 8)  //shake delay
	special(ShakeCamera)
	waitstate
	msgbox(format("Someone stole my research again!"))
	closemessage
	playse(SE_M_SELF_DESTRUCT)
	waitse
	msgbox(format("TEAM AQUAAAAAA!!"))
	msgbox(format("AAAAAAAAAH!!!"))
	closemessage
	playse(SE_M_TELEPORT)
	removeobject(MAWOOTAD_NPC)
	msgbox(format("(He teleported out of rage)"))
	waitse
	setflag(FLAG_HIDE_MAWOOTAD)
    return
}
