movement Route120_EventScript_MawootadNPCWalkAway{
    walk_right * 5
    walk_up * 2
    walk_right * 5
}
movement Route120_EventScript_MawootadNPCTrainerFollowUp{
    walk_right * 6
    walk_up * 2
    walk_right * 4
}
movement Route120_EventScript_MawootadNPCTrainerCatchUp{
    walk_down
    walk_right
}
